# Never commit real values. Set these as secrets in the private Site runtime.
ONSHAPE_ACCESS_KEY=
ONSHAPE_SECRET_KEY=
# JSON array of one to five document workspace/version/Part Studio URLs.
ONSHAPE_SOURCE_URLS=[]
# Optional, defaults to https://cad.onshape.com
ONSHAPE_BASE_URL=https://cad.onshape.com
